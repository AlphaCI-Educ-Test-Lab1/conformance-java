<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- AlphaCI education ruleset. Structural checks only. -->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Checker-level: LineLength moved out of TreeWalker in Checkstyle 8.24. -->
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^package.*|^import.*|https?://"/>
  </module>

  <module name="TreeWalker">
    <!-- Dead code the compiler accepts. -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- Defects, not opinions. An empty catch swallows the failure that
         would have explained the next one; a missing brace is how the
         classic dangling-else bug gets in. -->
    <module name="EmptyCatchBlock"/>
    <module name="NeedBraces"/>
    <module name="FallThrough"/>
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>

    <!-- Naming: the one stylistic group kept, because the convention is
         language-wide, unambiguous, and cheap to fix. -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="ConstantName"/>

    <!-- Matches the 4-space indentation this scaffold generates. If the
         generator ever changes width, change it here in the SAME commit or
         every new repository starts red. -->
    <module name="Indentation">
      <property name="basicOffset" value="4"/>
      <property name="lineWrappingIndentation" value="8"/>
    </module>
  </module>
</module>
